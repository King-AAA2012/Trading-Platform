# Copy this file to ".env" (same folder) and fill it in. Never commit your real .env; it is git-ignored.

# ---- Brand & legal (shown in the beta pop-up, footer and legal pages)
APP_NAME=CasuallyHedge
APP_MOTTO=Trading, for the little guy.
COMPANY_EMAIL=support@your-company-domain.com
LEGAL_ENTITY=Your Company Pvt. Ltd.
LEGAL_ADDRESS=Street, City, State, PIN, Country
JURISDICTION=India
SITE_URL=https://www.your-domain.com

# ---- Public beta: free for everyone and a BETA tag on every page. Set to 0 when you start charging.
CH_BETA=1
# Optional Postgres database (e.g. a free Neon database: postgresql://user:pass@host/db?sslmode=require) so accounts
# survive restarts on hosts whose disk is wiped (Render's free plan). Leave empty to use data/app.db (SQLite).
DATABASE_URL=

# ---- Trial & pricing (amounts in the smallest currency unit: 2000 = 20.00)
TRIAL_DAYS=30
PRICE_CURRENCY=USD
PRICE_MONTHLY=2000
PRICE_YEARLY=20000
# Charging in USD needs "International Payments" enabled on your Razorpay account.
# To charge in rupees instead, e.g.: PRICE_CURRENCY=INR, PRICE_MONTHLY=169900, PRICE_YEARLY=1699900

# ---- Razorpay (Dashboard -> Account & Settings -> API Keys; use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://www.your-domain.com/api/billing/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Security / hosting
COOKIE_SECURE=1          # 1 when the site is served over HTTPS (it must be, in production)
SESSION_DAYS=30
CH_HOST=127.0.0.1        # keep 127.0.0.1 behind a reverse proxy (Caddy/Nginx); 0.0.0.0 exposes it directly
# Emails that get free access forever (you, testers), comma-separated
COMP_EMAILS=you@example.com

# ---- Daily Desk emails (optional; messages always appear in the in-app inbox)
# Option A: Resend (https://resend.com)  RESEND_API_KEY=re_...   EMAIL_FROM=CasuallyHedge <desk@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Option B: any SMTP server, e.g. Gmail with an app password (smtp.gmail.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Private mode: where to send your own Daily Desk emails
NOTIFY_EMAIL=
# Set to 0 to switch off the scheduled jobs on this server
CH_JOBS=1
# Official filing sources for non-Indian stocks (comma-separated): sec (SEC EDGAR: US + foreign companies with a US listing),
# hkex (HKEXnews), asx (ASX announcements: free for private use only, needs ASX's agreement on a commercial site)
FILING_SOURCES=sec,hkex,asx
# SEC asks automated tools to identify themselves: "<app or company name> <contact email>" (defaults to APP_NAME + COMPANY_EMAIL)
SEC_USER_AGENT=
